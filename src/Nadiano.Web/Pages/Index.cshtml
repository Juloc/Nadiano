@page
@model IndexModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Home.Title"];
    var isIndonesian = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("id", StringComparison.OrdinalIgnoreCase);
    string T(string de, string id) => isIndonesian ? id : de;
}

<div class="today-hero">
    <section class="today-primary" aria-labelledby="today-heading">
        <div>
            <span class="eyebrow">@T("Heute", "Hari ini")</span>
            <h1 id="today-heading">@T("Deine nächste Klaviereinheit", "Sesi piano berikutnya")</h1>
            @if (Model.Summary.ReviewsDue.Count > 0)
            {
                <p>@T($"{Model.Summary.ReviewsDue.Count} Wiederholungen sind fällig. Nadiano mischt sie automatisch mit Lesen, Rhythmus, Gehör und Repertoire.", $"{Model.Summary.ReviewsDue.Count} ulasan sudah jatuh tempo. Nadiano otomatis mencampurnya dengan membaca, ritme, pendengaran, dan repertoar.")</p>
            }
            else if (Model.Summary.RecommendedLesson is not null)
            {
                <p>@T("Keine Wiederholung drängt. Heute kannst du mit der nächsten empfohlenen Lektion und einem kurzen Training weitergehen.", "Tidak ada ulasan mendesak. Hari ini kamu bisa melanjutkan dengan pelajaran rekomendasi berikutnya dan latihan singkat.")</p>
            }
            else
            {
                <p>@T("Nadiano verbindet Wiederholung, Lesen, Rhythmus, Gehör und echte Stücke zu einer klaren Übungseinheit.", "Nadiano menggabungkan ulasan, membaca, ritme, pendengaran, dan lagu nyata menjadi satu sesi latihan yang jelas.")</p>
            }
        </div>
        <div class="today-actions">
            <a class="button" asp-page="/Practice/Beta">@T("Heutiges Training starten", "Mulai latihan hari ini")</a>
            @if (Model.Summary.RecommendedLesson is not null)
            {
                <a class="button-secondary" asp-page="/Learn/Lesson" asp-route-lessonId="@Model.Summary.RecommendedLesson.LessonId">@T("Empfohlene Lektion", "Pelajaran rekomendasi")</a>
            }
            else
            {
                <a class="button-secondary" asp-page="/Learn/Index">@T("Lernpfad öffnen", "Buka jalur belajar")</a>
            }
        </div>
    </section>

    <aside class="today-side" aria-label="@T("Übersicht", "Ringkasan")">
        <section class="surface">
            <span class="eyebrow">@T("Ablauf", "Urutan")</span>
            <h2>@T("Eine klare Einheit", "Satu sesi yang jelas")</h2>
            <ol class="session-outline">
                <li><span class="session-step">1</span><span>@T("Kurz aufwärmen", "Pemanasan singkat")</span><span class="chip">2–3 min</span></li>
                <li><span class="session-step">2</span><span>@T("Fälliges wiederholen", "Ulangi materi jatuh tempo")</span><span class="chip">3–5 min</span></li>
                <li><span class="session-step">3</span><span>@T("Lesen oder Rhythmus", "Membaca atau ritme")</span><span class="chip">3–5 min</span></li>
                <li><span class="session-step">4</span><span>@T("An einem Stück arbeiten", "Latih sebuah lagu")</span><span class="chip">5–10 min</span></li>
                <li><span class="session-step">5</span><span>@T("Ergebnis prüfen", "Tinjau hasil")</span><span class="chip">1 min</span></li>
            </ol>
        </section>

        <section class="surface">
            <div class="quick-status">
                <div>
                    <strong>@T("Lernstand", "Kemajuan belajar")</strong>
                    <span class="help-text">@Model.Summary.CompletedLessonCount / @Model.Summary.TotalLessonCount @T("Lektionen abgeschlossen", "pelajaran selesai")</span>
                </div>
                <a class="button-secondary" asp-page="/Progress/Index">@T("Ansehen", "Lihat")</a>
            </div>
            <progress class="progress-meter" value="@Model.Summary.CompletedLessonCount" max="@Math.Max(1, Model.Summary.TotalLessonCount)" aria-label="@T("Kursfortschritt", "Kemajuan kursus")"></progress>
        </section>

        @if (Model.Summary.ReviewsDue.Count > 0)
        {
            var review = Model.Summary.ReviewsDue[0];
            <section class="surface quick-status">
                <div>
                    <strong>@T("Nächste Wiederholung", "Ulasan berikutnya")</strong>
                    <span class="help-text">@review.LessonTitle</span>
                </div>
                <a class="button-secondary" asp-page="/Learn/Lesson" asp-route-lessonId="@review.LessonId">@T("Öffnen", "Buka")</a>
            </section>
        }

        <section class="surface quick-status">
            <div>
                <strong>@T("MIDI bereit machen", "Siapkan MIDI")</strong>
                <span class="help-text">@T("Verbindung vor dem Spielen prüfen", "Periksa koneksi sebelum bermain")</span>
            </div>
            <a class="button-secondary" asp-page="/Setup/Index">@T("Prüfen", "Periksa")</a>
        </section>
    </aside>
</div>

<section class="page-heading" aria-labelledby="today-next-heading">
    <div class="page-heading-copy">
        <span class="eyebrow">@T("Direkt weiter", "Lanjut langsung")</span>
        <h2 id="today-next-heading">@T("Wähle nur, wenn du gezielt üben willst", "Pilih hanya jika ingin latihan khusus")</h2>
        <p>@T("Für normales tägliches Lernen reicht der Start oben. Einzelbereiche bleiben jederzeit erreichbar.", "Untuk latihan harian normal, tombol mulai di atas sudah cukup. Area khusus tetap selalu tersedia.")</p>
    </div>
</section>

<div class="card-grid">
    <a class="surface" asp-page="/Learn/Index" style="text-decoration:none;color:inherit">
        <span class="eyebrow">@T("Lernen", "Belajar")</span>
        <h3>@T("Kurs fortsetzen", "Lanjutkan kursus")</h3>
        <p class="help-text">@T("Notenlesen, Technik, Rhythmus und musikalische Grundlagen.", "Membaca not, teknik, ritme, dan dasar musik.")</p>
    </a>
    <a class="surface" asp-page="/Library/Index" style="text-decoration:none;color:inherit">
        <span class="eyebrow">@T("Songs", "Lagu")</span>
        <h3>@T("Stücke auswählen", "Pilih lagu")</h3>
        <p class="help-text">@T("Nadiano-Repertoire und eigene MusicXML/MXL-Dateien in einer Bibliothek.", "Repertoar Nadiano dan berkas MusicXML/MXL pribadi dalam satu perpustakaan.")</p>
    </a>
    <a class="surface" asp-page="/Progress/Index" style="text-decoration:none;color:inherit">
        <span class="eyebrow">@T("Fortschritt", "Kemajuan")</span>
        <h3>@T("Schwächen gezielt sehen", "Lihat area yang perlu diperbaiki")</h3>
        <p class="help-text">@T("Kompetenzen, Wiederholungen und nächste sinnvolle Schritte.", "Kompetensi, ulasan, dan langkah berikutnya yang masuk akal.")</p>
    </a>
</div>

@page
@model IndexModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Library.Title"];
}

<h1>@Localizer["Library.Title"]</h1>
<p>@Model.T("Eigene MusicXML- und MXL-Dateien werden nur im aktuellen Profil gespeichert.", "Berkas MusicXML dan MXL pribadi hanya disimpan dalam profil saat ini.")</p>

@if (Model.Notice is not null)
{
    <p class="callout" role="status">@Model.Notice</p>
}
@if (Model.Error is not null)
{
    <p class="callout" role="alert">@Model.Error</p>
}

<section class="card" aria-labelledby="import-heading">
    <h2 id="import-heading">@Model.T("Noten importieren", "Impor partitur")</h2>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Import">
        <div class="field-list">
            <div>
                <label for="upload">@Model.T("MusicXML- oder MXL-Datei", "Berkas MusicXML atau MXL")</label>
                <input id="upload" name="upload" type="file" accept=".musicxml,.xml,.mxl,application/vnd.recordare.musicxml+xml,application/vnd.recordare.musicxml" required />
            </div>
            <div>
                <label for="title">@Model.T("Titel (optional)", "Judul (opsional)")</label>
                <input id="title" name="title" maxlength="300" />
            </div>
        </div>
        <p class="help-text">@Model.T("Maximal 8 MB. Archive und XML werden vor dem Speichern auf unsichere Inhalte geprüft.", "Maksimal 8 MB. Arsip dan XML diperiksa terhadap konten tidak aman sebelum disimpan.")</p>
        <button class="button" type="submit">@Model.T("Importieren", "Impor")</button>
    </form>
</section>

<section aria-labelledby="private-library-heading">
    <h2 id="private-library-heading">@Model.T("Private Bibliothek", "Perpustakaan pribadi")</h2>
    @if (Model.Items.Count == 0)
    {
        <p>@Model.T("Noch keine eigenen Noten importiert.", "Belum ada partitur pribadi yang diimpor.")</p>
    }
    else
    {
        <div class="card-grid">
        @foreach (var item in Model.Items)
        {
            var metadata = Model.Metadata(item);
            var warnings = Model.Warnings(item);
            <article class="card">
                <h3>@item.DisplayTitle</h3>
                <p><strong>@Model.T("Status", "Status"):</strong> @item.ValidationState</p>
                <p>@metadata.PartCount @Model.T("Stimmen/Parts", "bagian") · @metadata.MeasureCount @Model.T("Takte", "birama") · @metadata.FingeringCount @Model.T("Fingersätze", "penjarian")</p>
                @if (warnings.Count > 0)
                {
                    <details>
                        <summary>@Model.T("Importwarnungen", "Peringatan impor") (@warnings.Count)</summary>
                        <ul>
                        @foreach (var warning in warnings)
                        {
                            <li>@warning</li>
                        }
                        </ul>
                    </details>
                }

                <form method="post" asp-page-handler="Update" class="field-list">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <div>
                        <label for="title-@item.Id">@Model.T("Titel", "Judul")</label>
                        <input id="title-@item.Id" name="title" value="@item.DisplayTitle" maxlength="300" />
                    </div>
                    <div>
                        <label for="from-@item.Id">@Model.T("Von Takt", "Dari birama")</label>
                        <input id="from-@item.Id" name="fromMeasure" type="number" min="1" max="@metadata.MeasureCount" value="@metadata.FromMeasure" />
                    </div>
                    <div>
                        <label for="to-@item.Id">@Model.T("Bis Takt", "Sampai birama")</label>
                        <input id="to-@item.Id" name="toMeasure" type="number" min="1" max="@metadata.MeasureCount" value="@metadata.ToMeasure" />
                    </div>
                    <div>
                        <label for="tempo-@item.Id">@Model.T("Zieltempo", "Tempo target")</label>
                        <input id="tempo-@item.Id" name="targetTempoBpm" type="number" min="30" max="240" value="@metadata.TargetTempoBpm" />
                    </div>
                    <button class="button-secondary" type="submit">@Model.T("Metadaten speichern", "Simpan metadata")</button>
                </form>

                <p>
                    @if (item.ValidationState == "ready")
                    {
                        <a class="button" asp-page="/Practice/Index" asp-route-libraryItemId="@item.Id">@Model.T("Üben", "Latihan")</a>
                    }
                    <a class="button-secondary" href="/api/library/@item.Id/score">@Model.T("Vorschau-Datei", "Berkas pratinjau")</a>
                    <a class="button-secondary" href="/api/library/@item.Id/export">@Model.T("Original exportieren", "Ekspor asli")</a>
                </p>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <button class="button-danger" type="submit">@Model.T("Löschen", "Hapus")</button>
                </form>
            </article>
        }
        </div>
    }
</section>

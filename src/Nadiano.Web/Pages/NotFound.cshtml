@page "/not-found"
@model NotFoundModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["NotFound.Title"];
}

<h1>@Localizer["NotFound.Title"]</h1>
<p>@Localizer["NotFound.Message"]</p>

<p>
    <a class="button" asp-page="/Index">@Localizer["Error.BackHome"]</a>
</p>

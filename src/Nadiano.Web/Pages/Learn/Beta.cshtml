@page
@model BetaModel
@{
    ViewData["Title"] = Model.Text("Anfängerkurs", "Kursus pemula");
}

<h1>@Model.Text("Anfängerkurs", "Kursus pemula")</h1>
<p>@Model.Text("110 geführte Lektionen und 220 reproduzierbare Übungen führen von F0 über F1, B1 und B2 bis zu ausgewählten E1-Grundlagen. Jede Lektion baut auf der vorherigen auf.", "110 pelajaran terpandu dan 220 latihan yang dapat direproduksi membentuk jalur dari F0, F1, B1, dan B2 hingga dasar E1 pilihan. Setiap pelajaran bergantung pada pelajaran sebelumnya.")</p>

@if (Model.NoticeCode is not null)
{
    <p class="callout" role="status">
        @(Model.NoticeCode switch
        {
            "completed" => Model.Text("Lektion abgeschlossen.", "Pelajaran selesai."),
            "already-completed" => Model.Text("Lektion war bereits abgeschlossen.", "Pelajaran sudah selesai."),
            "locked" => Model.Text("Die Voraussetzung ist noch nicht erfüllt.", "Prasyarat belum terpenuhi."),
            "stage-evidence-required" => Model.Text("Für die Stufenprüfung werden zuerst je ein aktueller Lese-, Rhythmus- und Gehörnachweis benötigt.", "Pemeriksaan tahap memerlukan bukti membaca, ritme, dan pendengaran terbaru."),
            _ => Model.Text("Aktion konnte nicht gespeichert werden.", "Tindakan tidak dapat disimpan."),
        })
    </p>
}

<p>
    <a class="button" asp-page="/Practice/Beta">@Model.Text("Training öffnen", "Buka latihan")</a>
</p>

@foreach (var stage in Model.Items.GroupBy(item => item.Lesson.Stage))
{
    <section aria-labelledby="stage-@stage.Key">
        <h2 id="stage-@stage.Key">@stage.Key</h2>
        <ol class="course-map">
        @foreach (var item in stage)
        {
            <li class="card" data-status="@item.Status">
                <h3>@Model.Title(item)</h3>
                <p>@Model.Goal(item)</p>
                <p><strong>@Model.Text("Kompetenz", "Kompetensi"):</strong> @item.Lesson.SkillId</p>
                <p><strong>@Model.Text("Status", "Status"):</strong> @item.Status</p>
                @if (item.LockedBy is not null)
                {
                    <p class="help-text">@Model.Text("Gesperrt durch", "Dikunci oleh"): @item.LockedBy</p>
                }
                @if (item.Status == "available")
                {
                    <form method="post" asp-page-handler="Complete">
                        <input type="hidden" name="lessonId" value="@item.Lesson.Id" />
                        <button class="button-secondary" type="submit">
                            @(item.Lesson.ActivityKind == "stage-check"
                                ? Model.Text("Stufenprüfung auswerten", "Evaluasi pemeriksaan tahap")
                                : Model.Text("Lektion abschließen", "Selesaikan pelajaran"))
                        </button>
                    </form>
                }
            </li>
        }
        </ol>
    </section>
}

@page "{lessonId}"
@model LessonModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Model.Text.Title;
    var isIndonesian = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("id", StringComparison.OrdinalIgnoreCase);
    string T(string de, string id) => isIndonesian ? id : de;
}

<header class="page-heading">
    <div class="page-heading-copy">
        <span class="eyebrow">@T("Lektion", "Pelajaran")</span>
        <h1>@Model.Text.Title</h1>
        <p>@Model.Text.Summary</p>
    </div>
    @if (Model.HasNotationPractice)
    {
        <a class="button" asp-page="/Practice/Index" asp-route-lessonId="@Model.LessonId">@T("Am Piano üben", "Latihan di piano")</a>
    }
</header>

<div class="progress-hero">
    <section class="surface" aria-labelledby="lesson-goal-heading">
        <span class="eyebrow">@T("Ziel", "Tujuan")</span>
        <h2 id="lesson-goal-heading">@Localizer["Lesson.GoalHeading"]</h2>
        <p id="lesson-cue">@Model.Text.Summary</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Text.Why))
    {
        <section class="surface" aria-labelledby="lesson-why-heading">
            <span class="eyebrow">@T("Warum", "Mengapa")</span>
            <h2 id="lesson-why-heading">@Localizer["Lesson.WhyHeading"]</h2>
            <p>@Model.Text.Why</p>
        </section>
    }
</div>

@if (Model.MediaViews.Count > 0)
{
    <section class="surface" aria-labelledby="lesson-demo-heading">
        <span class="eyebrow">@T("Demonstration", "Demonstrasi")</span>
        <h2 id="lesson-demo-heading">@Localizer["Lesson.DemonstrationHeading"]</h2>
        <p class="help-text">@Localizer["Lesson.DemonstrationTextAlternative"]</p>
        <div class="technique-media-list" data-loop="@Model.MediaLoops.ToString().ToLowerInvariant()">
            @foreach (var view in Model.MediaViews)
            {
                @if (view.MediaTag == "image")
                {
                    <img class="technique-media" src="@view.Url" alt="" data-kind="@view.Kind" />
                }
                else if (view.MediaTag == "audio")
                {
                    <audio class="technique-media" controls preload="metadata" data-kind="@view.Kind">
                        <source src="@view.Url" />
                    </audio>
                }
                else
                {
                    <video class="technique-media" controls preload="metadata" data-kind="@view.Kind" poster="@view.PosterUrl">
                        <source src="@view.Url" type="video/webm" />
                    </video>
                }
            }
        </div>
    </section>
}

@if (Model.Text.Steps.Count > 0 || !string.IsNullOrWhiteSpace(Model.Text.CommonMistake))
{
    <div class="progress-hero" style="margin-top:1rem">
        @if (Model.Text.Steps.Count > 0)
        {
            <section class="surface" aria-labelledby="lesson-steps-heading">
                <span class="eyebrow">@T("Ausprobieren", "Coba")</span>
                <h2 id="lesson-steps-heading">@Localizer["Lesson.StepsHeading"]</h2>
                <ol class="progress-list">
                    @foreach (var step in Model.Text.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Text.CommonMistake))
        {
            <section class="surface" aria-labelledby="lesson-mistake-heading">
                <span class="eyebrow">@T("Achte darauf", "Perhatikan")</span>
                <h2 id="lesson-mistake-heading">@Localizer["Lesson.CommonMistakeHeading"]</h2>
                <p>@Model.Text.CommonMistake</p>
            </section>
        }
    </div>
}

@if (Model.HasNotationPractice)
{
    <section class="surface" style="margin-top:1rem">
        <span class="eyebrow">@T("Jetzt spielen", "Sekarang bermain")</span>
        <h2>@T("Setze die Lektion am Piano um", "Terapkan pelajaran di piano")</h2>
        <p class="help-text">@Localizer["Lesson.PlayAtPianoHint"]</p>
        <a class="button" asp-page="/Practice/Index" asp-route-lessonId="@Model.LessonId">@T("Übung starten", "Mulai latihan")</a>
    </section>
}
else
{
    <section class="surface" id="lesson-dry-task" data-lesson-id="@Model.LessonId" data-content-version="@Model.ContentVersion" style="margin-top:1rem">
        <span class="eyebrow">@T("Aufgabe", "Tugas")</span>
        <p id="lesson-dry-task-status" class="callout" hidden>@Localizer["Lesson.DryTaskDone"]</p>
        <button id="lesson-dry-task-button" type="button" class="button">@Localizer["Lesson.DryTaskButton"]</button>
    </section>
}

@if (Model.SelfCheckSkillIds.Count > 0)
{
    <section aria-labelledby="lesson-selfcheck-heading" id="lesson-selfcheck-section" class="surface" hidden style="margin-top:1rem">
        <span class="eyebrow">@T("Selbstcheck", "Pemeriksaan diri")</span>
        <h2 id="lesson-selfcheck-heading">@Localizer["Lesson.SelfCheckHeading"]</h2>
        <p class="help-text">@Localizer["Lesson.SelfCheckDisclaimer"]</p>
        <ul id="lesson-selfcheck-list" data-lesson-id="@Model.LessonId" class="progress-list">
            @foreach (var skillId in Model.SelfCheckSkillIds)
            {
                <li class="self-check-item" data-skill-id="@skillId">
                    <span>@Localizer[$"SelfCheck.{skillId}"]</span>
                    <button type="button" class="button-secondary self-check-answer" data-value="true">@Localizer["Lesson.SelfCheckYes"]</button>
                    <button type="button" class="button-secondary self-check-answer" data-value="false">@Localizer["Lesson.SelfCheckNo"]</button>
                    <span class="self-check-answered help-text" hidden>@Localizer["Lesson.SelfCheckRecorded"]</span>
                </li>
            }
        </ul>
    </section>
}

@section Scripts {
    <script src="~/dist/pages/lesson.js" type="module" asp-append-version="true"></script>
}
